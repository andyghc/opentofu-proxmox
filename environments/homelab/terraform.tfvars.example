# ===========================================================================
# terraform.tfvars.example
# ===========================================================================
# Copy this file to terraform.tfvars and fill in your real values.
# WARNING: terraform.tfvars is in .gitignore — never commit secrets!
# ===========================================================================

# --- Proxmox Connection ---
proxmox_endpoint  = "https://pve1.local:8006/api2/json"
# Example api token format:
proxmox_api_token = "root@pam!HermesTF=8a42e476-daf8-4102-ab67-b65dac5ab276"
proxmox_insecure  = true
proxmox_node      = "pve1"

# --- VM Defaults ---
vm_template_name     = "Debian13Template"
vm_datastore         = "zfs1"
vm_default_username  = "andy"
vm_ssh_keys          = ["ssh-rsa  Andys"]
